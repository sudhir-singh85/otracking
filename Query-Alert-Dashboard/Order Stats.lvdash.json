{
  "datasets": [
    {
      "name": "e2af315d",
      "displayName": "ordercountbyproductcategory",
      "queryLines": [
        "USE CATALOG `dev`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "Select productcategory,count(distinct orderno) as totalorders\n",
        "from dev.tracking_sl.order\n",
        "group by productcategory"
      ]
    },
    {
      "name": "ad23afce",
      "displayName": "MonthlyStats",
      "queryLines": [
        "USE CATALOG `wrk_databricks_quest_001`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "select orderno,orderdate,estimatedcost,deliverycost\n",
        "from dev.tracking_sl.order"
      ]
    }
  ],
