{
  "evaluation": {
    "source": {
      "name": "totalorders",
      "display": "totalorders",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 2500.0
      }
    },
    "empty_result_state": "OK",
    "notification": {
      "retrigger_seconds": 0,
      "notify_on_ok": true
    }
  },
  "schedule": {
    "quartz_cron_schedule": "43 0 15 30 * ?",
    "timezone_id": "Asia/Calcutta"
  },
  "query_lines": [
    "Select productcategory,count(distinct orderno) as totalorders",
    "from dev.tracking_sl.order",
    "where productcategory = 'Consumables'",
    "group by productcategory"
  ]
}
